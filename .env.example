# Copy to .env and fill in. Never commit .env. Sandbox/test accounts only.
# Agents NEVER receive any of these values — only the gateway reads them.

# --- Mulligan gateway ---
MULLIGAN_ENV=dev
MULLIGAN_DEMO=1                     # enables POST /api/demo/reset
MULLIGAN_DASHBOARD_TOKEN=
MULLIGAN_SERVICE_TOKEN=             # Photon service + Fetch agent -> gateway
MULLIGAN_AGENT_TOKENS=              # e.g. claude_code:tok1,devin:tok2,rogue:tok3,rogue_replay:tok4 (replay sessions show as mode=replay)
MULLIGAN_API_PORT=8000              # REST + SSE, bound to 127.0.0.1 only (never tunneled)
MULLIGAN_MCP_PORT=8001              # MCP /mcp only. The ONLY port the cloudflared tunnel points at
MULLIGAN_API_URL=http://127.0.0.1:8000   # host processes and browser code. Containers use http://gateway:8000 (compose sets it)
MULLIGAN_MCP_PUBLIC_URL=            # the trycloudflare.com URL for Devin. Changes when the tunnel restarts; its host is allowed on the MCP port
MULLIGAN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # dashboard origins allowed to call the REST API

# --- Databases ---
MULLIGAN_DB_URL=postgresql://mulligan:mulligan@localhost:5433/mulligan  # TimescaleDB (action log)
PROD_DB_URL=postgresql://mulligan_gw:mulligan_gw@localhost:5434/acme    # demo company "production", as the gateway role that owns its tables
PROD_DB_READONLY_URL=postgresql://mulligan_ro:mulligan_ro@localhost:5434/acme  # SELECT-only login role for pg_query
PROD_DB_ADMIN_URL=postgresql://acme:acme@localhost:5434/acme           # demo reset and teammate_edit.py only
PG_QUERY_TIMEOUT_MS=5000              # statement_timeout for pg_query (read-only)
PG_QUERY_MAX_ROWS=1000                # row cap for pg_query
PG_ALLOWED_SCHEMAS=public             # schemas the Postgres tools may touch

# --- GitHub (throwaway org only) ---
GITHUB_TOKEN=
GITHUB_ORG=
GITHUB_REPO=
GITHUB_WRITE_INTERVAL_MS=1000       # gap between GitHub writes (GitHub asks for >= 1 s on bulk content creation)

# --- Notion (test workspace only) ---
NOTION_TOKEN=
NOTION_PRICING_PAGE_ID=

# --- Stripe (TEST MODE keys only: sk_test_...) ---
STRIPE_SECRET_KEY=
MULLIGAN_PAYMENT_UNDO_MINUTES=10      # an approved charge is captured after this undo window
MULLIGAN_HOLD_TTL_MINUTES=15          # an undecided hold expires after this (0 = never)

# --- Email (held channel) ---
EMAIL_PROVIDER=mailpit
EMAIL_FROM=billing@acme-widgets.test
EMAIL_SMTP_HOST=127.0.0.1             # Mailpit (make mailpit); compose sets mailpit
EMAIL_SMTP_PORT=1025
EMAIL_SEND_CORRECTIONS=1              # rewinding a sent email sends a correction (0 = just skip)

# --- Photon / spectrum-ts ---
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
APPROVER_PHONE=                     # E.164, the phone that receives approvals
APPROVER_HANDLE=                    # iMessage phone or Apple ID email of the approver; overrides APPROVER_PHONE. Must be on iMessage (Android RCS replies never reach Photon)
PHOTON_SERVICE_URL=http://127.0.0.1:8100   # from the host. The gateway container uses http://approvals-photon:8100 (compose sets it)

# --- Fetch.ai ---
GUARDIAN_AGENT_SEED=
WORKER_AGENT_SEED=
ASI_ONE_API_KEY=

# --- Upstream MCP servers behind Mulligan (their tools go through the rules gate) ---
UPSTREAM_MCP_SERVERS=               # e.g. slack=http://localhost:8200/mcp

# --- StepFun (optional) ---
STEPFUN_API_KEY=

# --- Sentry ---
SENTRY_DSN_GATEWAY=
SENTRY_DSN_DASHBOARD=
SENTRY_DSN_PHOTON=
SENTRY_ENVIRONMENT=dev

# --- Demo: live rogue agent ---
ROGUE_AGENT_API_KEY=                # LLM key for demo/rogue_agent.py --live; it reaches no system except through Mulligan
