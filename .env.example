# Copy to .env and fill in. Never commit .env. Sandbox/test accounts only.
# Agents NEVER receive any of these values — only the gateway reads them.

# --- Mulligan gateway ---
MULLIGAN_ENV=dev
MULLIGAN_DEMO=1                     # enables POST /api/demo/reset
MULLIGAN_DASHBOARD_TOKEN=
MULLIGAN_SERVICE_TOKEN=             # Photon service + Fetch agent -> gateway
MULLIGAN_AGENT_TOKENS=              # e.g. claude_code:tok1,devin:tok2,rogue:tok3,rogue_replay:tok4 (replay sessions show as mode=replay)
MULLIGAN_API_PORT=8000              # REST + SSE, bound to 127.0.0.1 only (never tunneled)
MULLIGAN_MCP_PORT=8001              # MCP /mcp only. The ONLY port the cloudflared tunnel points at
MULLIGAN_API_URL=http://127.0.0.1:8000
MULLIGAN_MCP_PUBLIC_URL=            # the trycloudflare.com URL for Devin. Changes when the tunnel restarts

# --- Databases ---
MULLIGAN_DB_URL=postgresql://mulligan:mulligan@localhost:5433/mulligan  # TimescaleDB (action log)
PROD_DB_URL=postgresql://acme:acme@localhost:5434/acme                  # demo company "production"
PG_QUERY_TIMEOUT_MS=5000              # statement_timeout for pg_query (read-only)

# --- GitHub (throwaway org only) ---
GITHUB_TOKEN=
GITHUB_ORG=
GITHUB_REPO=

# --- Notion (test workspace only) ---
NOTION_TOKEN=
NOTION_PRICING_PAGE_ID=

# --- Stripe (TEST MODE keys only: sk_test_...) ---
STRIPE_SECRET_KEY=

# --- Email (held channel) ---
EMAIL_PROVIDER=mailpit
EMAIL_FROM=

# --- Photon / spectrum-ts ---
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
APPROVER_PHONE=                     # E.164, the phone that receives approvals
APPROVER_HANDLE=                    # iMessage phone or Apple ID email of the approver; overrides APPROVER_PHONE. Must be on iMessage (Android RCS replies never reach Photon)
PHOTON_SERVICE_URL=http://localhost:8100

# --- Fetch.ai ---
GUARDIAN_AGENT_SEED=
WORKER_AGENT_SEED=
ASI_ONE_API_KEY=

# --- Upstream MCP servers behind Mulligan (their tools go through the rules gate) ---
UPSTREAM_MCP_SERVERS=               # e.g. slack=http://localhost:8200/mcp

# --- StepFun (optional) ---
STEPFUN_API_KEY=

# --- Sentry ---
SENTRY_DSN_GATEWAY=
SENTRY_DSN_DASHBOARD=
SENTRY_DSN_PHOTON=
SENTRY_ENVIRONMENT=dev

# --- Demo: live rogue agent ---
ROGUE_AGENT_API_KEY=                # LLM key for demo/rogue_agent.py --live; it reaches no system except through Mulligan
