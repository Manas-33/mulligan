# Copy to .env and fill in. Never commit .env. Sandbox/test accounts only.
# Agents NEVER receive any of these values — only the gateway reads them.

# --- Rewind gateway ---
REWIND_ENV=dev
REWIND_DEMO=1                       # enables POST /api/demo/reset
REWIND_DASHBOARD_TOKEN=
REWIND_SERVICE_TOKEN=               # Photon service + Fetch agent -> gateway
REWIND_AGENT_TOKENS=                # e.g. claude_code:tok1,devin:tok2,rogue:tok3
REWIND_PUBLIC_URL=http://localhost:8000

# --- Databases ---
REWIND_DB_URL=postgresql://rewind:rewind@localhost:5433/rewind      # TimescaleDB (action log)
PROD_DB_URL=postgresql://acme:acme@localhost:5434/acme              # demo company "production"

# --- GitHub (throwaway org only) ---
GITHUB_TOKEN=
GITHUB_ORG=
GITHUB_REPO=

# --- Notion (test workspace only) ---
NOTION_TOKEN=
NOTION_PRICING_PAGE_ID=

# --- Stripe (TEST MODE keys only: sk_test_...) ---
STRIPE_SECRET_KEY=

# --- Email (held channel) ---
EMAIL_PROVIDER=mailpit
EMAIL_FROM=

# --- Photon / spectrum-ts ---
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
APPROVER_PHONE=                     # E.164, the phone that receives approvals
PHOTON_SERVICE_URL=http://localhost:8100

# --- Fetch.ai ---
GUARDIAN_AGENT_SEED=
WORKER_AGENT_SEED=
ASI_ONE_API_KEY=

# --- Classifier (veri.studio) ---
CLASSIFIER_URL=
CLASSIFIER_TIMEOUT_MS=300

# --- StepFun (optional) ---
STEPFUN_API_KEY=

# --- Sentry ---
SENTRY_DSN_GATEWAY=
SENTRY_DSN_DASHBOARD=
SENTRY_DSN_PHOTON=
SENTRY_ENVIRONMENT=dev
